---
import {ArrowRight, DoorOpen, KeyRound, Vault, Scale, Blinds} from "lucide-react";

const services = [
    {
        icon: DoorOpen,
        title: "Apertura porte",
        description: "Apertura di porte senza danni, con tecniche professionali e ricambio serrature e cilindri."
    },
    {
        icon: KeyRound,
        title: "Sostituzione serrature",
        description: "Installazione e sostituzione di serrature certificate di alta sicurezza. Migliora la protezione della tua casa o ufficio."
    },
    {
        icon: Vault,
        title: "Apertura cassaforte",
        description: "Apertura di casseforti con la massima riservatezza, anche in caso di chiave smarrita o combinazione dimenticata."
    },
    {
        icon: Scale,
        title: "Apertura causa sfratto",
        description: "Collaboriamo costantemente con gli Enti Pubblici per il servizio di apertura serrature, in caso di sfratto giudiziario di abitazioni, capannoni, uffici, box ecc."
    },
    {
        icon: Blinds,
        title: "Serrande e Tapparelle",
        description: "Riparazione, manutenzione e installazione di serrande e tapparelle. Ripristiniamo la funzionalità e la sicurezza dei vostri avvolgibili."
    },
];
---

<div id="servizi" class="relative mx-auto my-16 max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-[1.1] text-slate-900">
            I Nostri <span class="text-brand-blue">Servizi</span>
        </h2>
        <p class="mt-4 text-base text-slate-600 max-w-2xl mx-auto leading-relaxed font-medium">
            Interventi rapidi, professionali e sicuri per ogni tua esigenza a Gorgonzola e dintorni.
        </p>
    </div>

    <div class="flex flex-wrap justify-center gap-6">
        {services.map((service) => (
                <div class="group relative w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] rounded-3xl bg-white p-6 sm:p-8 shadow-xl shadow-slate-900/5 border border-slate-200/60 hover:border-brand-blue/40 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-2xl bg-shade-blue text-brand-blue flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                            <service.icon className="w-6 h-6"/>
                        </div>
                        <h3 class="text-xl font-extrabold text-slate-900 mb-3 tracking-tight">
                            {service.title}
                        </h3>
                        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                            {service.description}
                        </p>
                    </div>

                    <div class="mt-8 pt-5 border-t border-slate-100">
                        <a href="tel:3333107476"
                           class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-brand-blue group-hover:text-blue-700 transition-colors">
                            <span>Richiedi il servizio</span>
                            <ArrowRight
                                    className="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5"/>
                        </a>
                    </div>
                </div>
        ))}
    </div>
</div>