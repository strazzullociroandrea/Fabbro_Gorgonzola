---
import {MapPin, Phone, ShieldCheck, Clock, CheckCircle2} from "lucide-react";
---

<section id="hero" class="w-full bg-shade py-12 sm:py-20 border-b border-slate-200/50">
    <div class="mx-auto flex w-full max-w-7xl flex-col justify-center px-4 sm:px-6 lg:px-8">

        <div class="mb-6 text-center md:text-left">
            <div class="inline-flex items-center gap-2 rounded-full bg-shade-blue px-4 py-1.5 text-xs font-bold text-brand-blue shadow-sm sm:text-sm border border-blue-500/20">
                <MapPin className="h-4 w-4 shrink-0"/>
                <span>INTERVENTO A GORGONZOLA (MI)</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">

            <div class="md:col-span-7 text-center md:text-left flex flex-col justify-center">
                <h1 class="text-4xl font-black tracking-tight text-slate-900 sm:text-5xl lg:text-6xl leading-[1.1]">
                    Fabbro <span class="text-brand-blue block sm:inline">Gorgonzola</span>
                </h1>

                <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg font-normal leading-relaxed text-slate-600 md:mx-0">
                    Riparazione e sostituzione serrature, apertura porte blindate e casseforti, serrande e tapparelle.
                    Interventi rapidi e professionali.
                </p>

                <div class="mt-8 flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4">
                    <a
                            href="tel:3333107476"
                            class="group inline-flex w-full sm:w-auto items-center justify-center space-x-3 rounded-2xl bg-brand-blue px-8 py-4 text-base font-bold text-white shadow-xl shadow-blue-900/25 transition-all duration-200 hover:brightness-110 active:scale-95 sm:text-lg"
                    >
                        <Phone className="h-5 w-5 transition-transform group-hover:rotate-12 shrink-0"/>
                        <span>Chiama 333 310 7476</span>
                    </a>
                </div>

                <div class="mt-8 pt-8 border-t border-blue-200/50 grid grid-cols-2 gap-4 text-left">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 rounded-xl bg-shade-blue text-brand-blue shrink-0 flex items-center justify-center border border-blue-500/10">
                            <Clock className="w-5 h-5"/>
                        </div>
                        <div>
                            <span class="block text-xs text-slate-500 font-medium">Lun-Ven</span>
                            <span class="text-sm font-bold text-slate-900">7:30 - 20:00</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 rounded-xl bg-shade-blue text-brand-blue shrink-0 flex items-center justify-center border border-blue-500/10">
                            <ShieldCheck className="w-5 h-5"/>
                        </div>
                        <div>
                            <span class="block text-xs text-slate-500 font-medium">Garanzia</span>
                            <span class="text-sm font-bold text-slate-900">100% Sicuro</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="md:col-span-5">
                <div class="relative rounded-3xl bg-white p-6 sm:p-8 shadow-xl shadow-slate-900/5 border border-blue-100">

                    <h3 class="text-xl font-extrabold text-slate-900 mb-4">Cosa facciamo?</h3>
                    <ul class="space-y-3.5 text-slate-600 text-sm sm:text-base font-medium">
                        <li class="flex items-center gap-3">
                            <CheckCircle2 className="w-5 h-5 text-brand-blue shrink-0"/>
                            <span>Apertura porte blindate bloccate</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <CheckCircle2 className="w-5 h-5 text-brand-blue shrink-0"/>
                            <span>Sostituzione serrature</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <CheckCircle2 className="w-5 h-5 text-brand-blue shrink-0"/>
                            <span>Riparazione serrande, tapparelle</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <CheckCircle2 className="w-5 h-5 text-brand-blue shrink-0"/>
                            <span>Casseforti</span>
                        </li>
                    </ul>

                    <div class="mt-6 pt-6 border-t border-slate-100 text-center">
                        <a href="tel:3333107476"
                           class="inline-block w-full py-3 px-4 rounded-xl bg-shade-blue text-brand-blue hover:bg-brand-blue hover:text-white font-bold text-sm transition-all duration-200">
                            Contattaci
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>