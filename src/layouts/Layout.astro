---
import '../styles/global.css';
import React from 'react';
import {GoToUp} from "../components/go-to-up.tsx";
import CookieBanner from "../components/cookie-banner.tsx";
interface Props {
    title?: string;
}
const {
    title,
} = Astro.props;
---


<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <link rel="icon" type="image/png" sizes="32x32" href="/logo.png?v=2"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/logo.png?v=2"/>
    <link rel="apple-touch-icon" href="/logo.png?v=2"/>
    <link rel="canonical" href="https://fabbroserraturegorgonzola.it"/>
    <meta name="robots" content="index, follow">
    <meta name="description"
          content="Riparazione e sostituzione serrature, apertura porte blindate e casseforti, serrande e tapparelle. Interventi rapidi e professionali."/>
    <title>{title}</title>
    <meta name="author" content="https://cirostrazzullo.it"/>
    <meta name="keywords"
          content="Fabbro Gorgonzola, Fabbro a Gorgonzola, Pronto intervento fabbro Gorgonzola, Apertura porte Gorgonzola, Sostituzione serrature Gorgonzola, Cambio cilindro Gorgonzola, Fabbro urgente Gorgonzola"/>
    <meta property="og:title" content="Fabbro Gorgonzola | Sostituzione e riparazione serrature, pronto intervento"/>
    <meta property="og:description"
          content="Riparazione e sostituzione serrature, apertura porte blindate e casseforti, serrande e tapparelle. Interventi rapidi e professionali."/>
    <meta property="og:type" content="website"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Locksmith",
            "name": "Fabbro Gorgonzola | Sostituzione e riparazione serrature, pronto intervento",
            "image": "https://fabbroserraturegorgonzola.it/logo.png",
            "@id": "https://fabbroserraturegorgonzola.it",
            "url": "https://fabbroserraturegorgonzola.it",
            "telephone": "+393333107476",
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 45.5293,
                "longitude": 9.4087
            },
            "openingHoursSpecification": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday",
                    "Friday"
                ],
                "opens": "07:30",
                "closes": "20:00"
            },
            "areaServed": [
                {
                    "@type": "City",
                    "name": "Gorgonzola"
                }
            ]
        }
    </script>
</head>

<body>
<GoToUp client:load/>
<CookieBanner client:load/>
<slot/>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>